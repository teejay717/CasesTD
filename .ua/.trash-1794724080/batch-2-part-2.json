  {
   "id": "file:src/main/java/btd/ui/screens/GamePanel.java",
   "type": "file",
   "name": "GamePanel.java",
   "filePath": "src/main/java/btd/ui/screens/GamePanel.java",
   "summary": "Main gameplay screen: runs a fixed-timestep game loop (1/60 s accumulator with x1/x2/x3 speed, paused while the shop is open), handles mouse/keyboard input for placing, selecting, upgrading and selling towers, renders the map, towers, enemies, effects and HUD, and saves new high scores when the run ends.",
   "tags": [
    "component",
    "game-loop",
    "rendering",
    "event-handler",
    "ui"
   ],
   "complexity": "complex",
   "languageNotes": "Swing Timer drives tick(); a time accumulator decouples simulation steps from repaint rate. Implements SidePanel.Actions as a callback interface."
  },
