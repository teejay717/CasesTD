   "id": "table:database/schema.sql",
   "type": "table",
   "name": "schema.sql",
   "filePath": "database/schema.sql",
   "summary": "MySQL schema creating btd_case_db with the rebuildable catalog tables towers, cases, and case_towers plus a persistent players table for highest scores.",
   "tags": [
    "database",
    "schema-definition",
    "migration",
    "sql"
   ],
   "complexity": "moderate",
   "languageNotes": "Uses DROP-then-CREATE for catalog tables but CREATE TABLE IF NOT EXISTS for players so re-running preserves scores; a CHECK constraint enforces case rarity weights summing to 100."
  },
