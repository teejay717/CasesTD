   "name": "WaveSpawner.java",
   "filePath": "src/main/java/btd/core/WaveSpawner.java",
   "summary": "Builds a time-stamped spawn queue per wave from JSON config (or a formula for later waves), adds a boss every Nth wave, and releases enemies as time elapses.",
   "tags": [
    "service",
    "wave-generation",
    "spawner",
    "procedural"
   ],
   "complexity": "moderate",
   "languageNotes": "Uses a private nested record Spawn(time, type) as a lightweight immutable queue entry."
  },
